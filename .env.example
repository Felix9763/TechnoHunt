# Supabase credentials (get these from Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Auth secrets (at least 32 characters for JOSE HS256)
SESSION_SECRET=super-secret-key-for-team-session-jwt-at-least-32-chars-long
ADMIN_SESSION_SECRET=super-secret-key-for-admin-session-jwt-at-least-32-chars-long

# Admin passcode for logging into /admin/login
ADMIN_PASSCODE=huntadmin2026
